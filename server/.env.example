PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prepai
JWT_SECRET=prepai_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Phase 5: Google Gemini AI Mock Interview API Key
# To use live Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Set MOCK_AI=true to run realistic simulated AI mock interviews offline without consuming Gemini API credits/quota:
MOCK_AI=false

# Isolated Sandboxed Code Execution (Judge0 CE / RapidAPI / Self-Hosted)
# Enables safe containerized execution for JavaScript, Python, Java, and C++
JUDGE0_API_KEY=your_judge0_api_key_or_rapidapi_key_here
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Strictly for local offline development unit testing only (defaults to false in production):
ENABLE_LOCAL_UNSAFE_RUNNER=false

